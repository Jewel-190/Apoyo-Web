# Copy to ".env.local" (gitignored). Read by Vite at dev/build time.
# Use the public anon / publishable key only. Never put service_role here.
# Pages load through GET /functions/v1/web; catalog tables use anon RLS.

VITE_SUPABASE_URL=https://api.apoyo-dasma.online
VITE_SUPABASE_ANON_KEY=your-public-anon-or-publishable-key
